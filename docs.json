{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Zenda",
  "theme": "mint",
  "colors": {
    "primary": "#FA4616",
    "light": "#FA4616",
    "dark": "#FA4616"
  },
  "background": {
    "color": {
      "light": "#FFFFFF",
      "dark": "#000000"
    }
  },
  "appearance": {
    "default": "dark"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "favicon": "/logo/favicon.svg",
  "navbar": {
    "links": [
      {
        "label": "Site",
        "href": "https://zendachat.com"
      },
      {
        "label": "Preços",
        "href": "https://zendachat.com/pricing"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.zendachat.com/dashboard"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Começar",
        "pages": ["introduction", "primeiros-passos"]
      },
      {
        "group": "Agente",
        "pages": [
          "guias/playground",
          "guias/configuracoes",
          "guias/analytics"
        ]
      },
      {
        "group": "Conhecimento",
        "pages": ["guias/fontes/overview"]
      },
      {
        "group": "Ações",
        "pages": [
          "guias/acoes/overview",
          "guias/acoes/leads",
          "guias/acoes/cta",
          "guias/acoes/nuvemshop"
        ]
      },
      {
        "group": "Publicar",
        "pages": [
          "guias/publicar/overview",
          "guias/publicar/widget",
          "guias/publicar/nuvemshop",
          "guias/publicar/help-page",
          "guias/publicar/whatsapp"
        ]
      },
      {
        "group": "Atendimento",
        "pages": ["guias/activity/overview"]
      },
      {
        "group": "Conta",
        "pages": [
          "guias/conta/workspace",
          "guias/conta/plano-e-creditos"
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/guias/acoes/shopify",
      "destination": "/guias/acoes/nuvemshop"
    }
  ],
  "footer": {
    "socials": {
      "website": "https://zendachat.com"
    }
  }
}
